ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_DEFAULT=60/minute

# From your Supabase project: Settings -> API. The anon (public) key is safe
# to use here since Postgres row-level security (see backend/supabase/schema.sql)
# is what actually restricts access, not this key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

MAX_UPLOAD_SIZE_BYTES=10485760
